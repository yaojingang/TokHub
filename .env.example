TOKHUB_ENV=development
TOKHUB_ROLE=all
TOKHUB_HOST_PORT=8080
TOKHUB_PUBLIC_URL=http://localhost:8080
TOKHUB_ADMIN_EMAIL=admin@tokhub.local
TOKHUB_ADMIN_PASSWORD=admin@tokhub.local
TOKHUB_SECRET_KEY=dev-only-change-this-secret-key-32b
# Optional multi-key credential vault. Leave empty in local development to derive legacy-v1 from TOKHUB_SECRET_KEY.
TOKHUB_CREDENTIAL_ACTIVE_KEY_ID=legacy-v1
TOKHUB_CREDENTIAL_ENCRYPTION_KEYS=
TOKHUB_CREDENTIAL_ACTIVE_FINGERPRINT_KEY_ID=legacy-v1
TOKHUB_CREDENTIAL_FINGERPRINT_KEYS=
TOKHUB_SEED_MODE=prod
TOKHUB_UPSTREAM_MODE=mock
TOKHUB_DOCS_DIR=docs
TOKHUB_SESSION_SECURE=false
TOKHUB_REGISTRATION_OPEN=true
TOKHUB_EXPOSE_DEV_TOKENS=true
TOKHUB_ADMIN_AGENT_ENABLED=true
DATABASE_URL=postgres://tokhub:tokhub@db:5432/tokhub?sslmode=disable
REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222
# smtp://user:pass@smtp.example.com:587?from=noreply@example.com&starttls=true
SMTP_URL=
TOKHUB_PROBE_CONCURRENCY=8
TOKHUB_GATEWAY_DEFAULT_QPS=60
# Personal AI web authorization. Keep the global flag off until Redis and credential keyrings are ready.
TOKHUB_AI_WEB_AUTH_ENABLED=false
TOKHUB_AI_GEMINI_OAUTH_ENABLED=false
TOKHUB_AI_DEEPSEEK_GUIDED_ENABLED=true
TOKHUB_AI_DEEPSEEK_WEB_EXPERIMENTAL=false
TOKHUB_AI_DEEPSEEK_WEB_BRIDGE_URL=http://deepseek-web-bridge:5001
# Required exact value when DeepSeek web-session experimental mode is enabled:
# I_ACCEPT_DEEPSEEK_WEB_SESSION_EXPERIMENTAL_RISK
TOKHUB_AI_DEEPSEEK_WEB_ACK=
# Local OpenCLI browser connector for personal ChatGPT, Gemini and DeepSeek tasks.
# Requires exact acknowledgement and remains disabled by default:
# I_ACCEPT_OPENCLI_PERSONAL_BROWSER_EXPERIMENTAL_RISK
TOKHUB_AI_OPENCLI_BROWSER_EXPERIMENTAL=false
TOKHUB_AI_OPENCLI_BROWSER_ACK=
TOKHUB_AI_OPENCLI_BROWSER_TASK_TIMEOUT=2m
TOKHUB_AI_OPENCLI_CHATGPT_ENABLED=true
TOKHUB_AI_OPENCLI_GEMINI_ENABLED=true
TOKHUB_AI_OPENCLI_DEEPSEEK_ENABLED=true
TOKHUB_AI_OPENCLI_CHATGPT_MIN_INTERVAL=10s
TOKHUB_AI_OPENCLI_GEMINI_MIN_INTERVAL=10s
TOKHUB_AI_OPENCLI_DEEPSEEK_MIN_INTERVAL=15s
TOKHUB_AI_OPENCLI_CHATGPT_HOURLY_LIMIT=30
TOKHUB_AI_OPENCLI_GEMINI_HOURLY_LIMIT=30
TOKHUB_AI_OPENCLI_DEEPSEEK_HOURLY_LIMIT=20
TOKHUB_AI_OPENCLI_CHATGPT_DAILY_LIMIT=120
TOKHUB_AI_OPENCLI_GEMINI_DAILY_LIMIT=120
TOKHUB_AI_OPENCLI_DEEPSEEK_DAILY_LIMIT=80
# Required in production even though the bridge is not published to a host port.
TOKHUB_DEEPSEEK_WEB_BRIDGE_ADMIN_KEY=
TOKHUB_AI_CHATGPT_CODEX_EXPERIMENTAL=false
TOKHUB_AI_OAUTH_TTL=10m
TOKHUB_AI_OAUTH_REFRESH_SKEW=5m
TOKHUB_AI_OAUTH_REFRESH_WORKERS=8
TOKHUB_AI_OAUTH_PROVIDER_CONCURRENCY=4
TOKHUB_AI_OAUTH_PROVIDER_QPS=2
TOKHUB_AI_OAUTH_REFRESH_ATTEMPT_TIMEOUT=20s
TOKHUB_GOOGLE_OAUTH_CLIENT_ID=
TOKHUB_GOOGLE_OAUTH_CLIENT_SECRET=
TOKHUB_GOOGLE_OAUTH_PROJECT_ID=
# Required exact value when ChatGPT Codex experimental mode is enabled:
# I_ACCEPT_CHATGPT_CODEX_EXPERIMENTAL_RISK
TOKHUB_AI_EXPERIMENTAL_BRIDGE_ACK=
# Real-provider RC smoke. Keep TOKHUB_REAL_PROVIDER_KEY out of committed env files.
TOKHUB_REAL_PROVIDER_NAME=OpenAI
TOKHUB_REAL_PROVIDER_TYPE=openai-compatible
TOKHUB_REAL_PROVIDER_ENDPOINT=
TOKHUB_REAL_PROVIDER_MODEL=
TOKHUB_REAL_PROVIDER_KEY=
TOKHUB_REAL_PROVIDER_INPUT_PER_MTOK=
TOKHUB_REAL_PROVIDER_OUTPUT_PER_MTOK=
