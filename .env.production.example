TOKHUB_ENV=production
TOKHUB_ROLE=all
TOKHUB_HOST_PORT=8080
TOKHUB_PUBLIC_URL=https://tokhub.example.com
TOKHUB_ADMIN_EMAIL=admin@example.com
TOKHUB_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
TOKHUB_SECRET_KEY=replace-with-at-least-32-random-characters
# Comma-separated key-id:secret pairs. Keep retired keys here until every stored credential has been re-encrypted.
TOKHUB_CREDENTIAL_ACTIVE_KEY_ID=enc-v1
TOKHUB_CREDENTIAL_ENCRYPTION_KEYS=enc-v1:replace-with-a-different-32-character-secret
TOKHUB_CREDENTIAL_ACTIVE_FINGERPRINT_KEY_ID=fp-v1
TOKHUB_CREDENTIAL_FINGERPRINT_KEYS=fp-v1:replace-with-another-32-character-secret
TOKHUB_SEED_MODE=prod
TOKHUB_UPSTREAM_MODE=real
TOKHUB_DOCS_DIR=/app/docs
TOKHUB_SESSION_SECURE=true
TOKHUB_REGISTRATION_OPEN=false
TOKHUB_EXPOSE_DEV_TOKENS=false
TOKHUB_ADMIN_AGENT_ENABLED=false
DATABASE_URL=postgres://tokhub:replace-password@postgres.example.com:5432/tokhub?sslmode=require
REDIS_URL=redis://redis.example.com:6379/0
NATS_URL=nats://nats.example.com:4222
# smtp://user:pass@smtp.example.com:587?from=noreply@example.com&starttls=true
SMTP_URL=
TOKHUB_PROBE_CONCURRENCY=8
TOKHUB_GATEWAY_DEFAULT_QPS=60
# Personal AI authorization ships disabled. Enable each adapter after its release gate is complete.
TOKHUB_AI_WEB_AUTH_ENABLED=false
TOKHUB_AI_GEMINI_OAUTH_ENABLED=false
TOKHUB_AI_DEEPSEEK_GUIDED_ENABLED=true
TOKHUB_AI_DEEPSEEK_WEB_EXPERIMENTAL=false
TOKHUB_AI_DEEPSEEK_WEB_BRIDGE_URL=http://deepseek-web-bridge:5001
# Required exact value when DeepSeek web-session experimental mode is enabled:
# I_ACCEPT_DEEPSEEK_WEB_SESSION_EXPERIMENTAL_RISK
TOKHUB_AI_DEEPSEEK_WEB_ACK=
TOKHUB_DEEPSEEK_WEB_BRIDGE_ADMIN_KEY=replace-with-a-long-random-bridge-admin-key
# Local OpenCLI browser connector. Required exact acknowledgement when enabled:
# I_ACCEPT_OPENCLI_PERSONAL_BROWSER_EXPERIMENTAL_RISK
TOKHUB_AI_OPENCLI_BROWSER_EXPERIMENTAL=false
TOKHUB_AI_OPENCLI_BROWSER_ACK=
TOKHUB_AI_OPENCLI_BROWSER_TASK_TIMEOUT=2m
TOKHUB_AI_OPENCLI_CHATGPT_ENABLED=true
TOKHUB_AI_OPENCLI_GEMINI_ENABLED=true
TOKHUB_AI_OPENCLI_DEEPSEEK_ENABLED=true
TOKHUB_AI_OPENCLI_CHATGPT_MIN_INTERVAL=10s
TOKHUB_AI_OPENCLI_GEMINI_MIN_INTERVAL=10s
TOKHUB_AI_OPENCLI_DEEPSEEK_MIN_INTERVAL=15s
TOKHUB_AI_OPENCLI_CHATGPT_HOURLY_LIMIT=30
TOKHUB_AI_OPENCLI_GEMINI_HOURLY_LIMIT=30
TOKHUB_AI_OPENCLI_DEEPSEEK_HOURLY_LIMIT=20
TOKHUB_AI_OPENCLI_CHATGPT_DAILY_LIMIT=120
TOKHUB_AI_OPENCLI_GEMINI_DAILY_LIMIT=120
TOKHUB_AI_OPENCLI_DEEPSEEK_DAILY_LIMIT=80
TOKHUB_AI_CHATGPT_CODEX_EXPERIMENTAL=false
TOKHUB_AI_OAUTH_TTL=10m
TOKHUB_AI_OAUTH_REFRESH_SKEW=5m
TOKHUB_AI_OAUTH_REFRESH_WORKERS=8
TOKHUB_AI_OAUTH_PROVIDER_CONCURRENCY=4
TOKHUB_AI_OAUTH_PROVIDER_QPS=2
TOKHUB_AI_OAUTH_REFRESH_ATTEMPT_TIMEOUT=20s
# Store the client secret in the deployment secret manager.
TOKHUB_GOOGLE_OAUTH_CLIENT_ID=
TOKHUB_GOOGLE_OAUTH_CLIENT_SECRET=
TOKHUB_GOOGLE_OAUTH_PROJECT_ID=
# Self-hosted experimental deployments only. Required exact value:
# I_ACCEPT_CHATGPT_CODEX_EXPERIMENTAL_RISK
TOKHUB_AI_EXPERIMENTAL_BRIDGE_ACK=
# Real-provider RC smoke. Provide values via deployment secrets, not committed env files.
TOKHUB_REAL_PROVIDER_NAME=OpenAI
TOKHUB_REAL_PROVIDER_TYPE=openai-compatible
TOKHUB_REAL_PROVIDER_ENDPOINT=
TOKHUB_REAL_PROVIDER_MODEL=
TOKHUB_REAL_PROVIDER_KEY=
TOKHUB_REAL_PROVIDER_INPUT_PER_MTOK=
TOKHUB_REAL_PROVIDER_OUTPUT_PER_MTOK=
# Optional second and third real providers for Phase 12.2.
TOKHUB_REAL_PROVIDER_2_NAME=
TOKHUB_REAL_PROVIDER_2_TYPE=openai-compatible
TOKHUB_REAL_PROVIDER_2_ENDPOINT=
TOKHUB_REAL_PROVIDER_2_MODEL=
TOKHUB_REAL_PROVIDER_2_KEY=
TOKHUB_REAL_PROVIDER_2_INPUT_PER_MTOK=
TOKHUB_REAL_PROVIDER_2_OUTPUT_PER_MTOK=
TOKHUB_REAL_PROVIDER_3_NAME=
TOKHUB_REAL_PROVIDER_3_TYPE=openai-compatible
TOKHUB_REAL_PROVIDER_3_ENDPOINT=
TOKHUB_REAL_PROVIDER_3_MODEL=
TOKHUB_REAL_PROVIDER_3_KEY=
TOKHUB_REAL_PROVIDER_3_INPUT_PER_MTOK=
TOKHUB_REAL_PROVIDER_3_OUTPUT_PER_MTOK=
# Phase 12.2 external delivery checks. Keep secrets out of committed env files.
TOKHUB_PHASE12_SMTP_TEST_EMAIL=
TOKHUB_PHASE12_NOTIFICATION_TYPE=webhook
TOKHUB_PHASE12_NOTIFICATION_TARGET=
TOKHUB_PHASE12_PROVIDER_PUBLIC_VISIBLE=false
